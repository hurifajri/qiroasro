# Application
NEXT_PUBLIC_APP_NAME="Qiroasro"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (Better Auth)
# Generate a random secret (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Database (PostgreSQL / Supabase / Neon)
# DATABASE_URL: Transaction pooler (e.g. port 6543)
DATABASE_URL="postgresql://user:password@localhost:5432/qiroasro"
# DATABASE_URL_DIRECT: Session pooler / direct connection for migrations (e.g. port 5432)
DATABASE_URL_DIRECT="postgresql://user:password@localhost:5432/qiroasro"
